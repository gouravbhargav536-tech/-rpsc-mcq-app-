rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection and subcollections (recursive)
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
      
      match /{allPaths=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Quizzes collection (centralized)
    match /quizzes/{quizId} {
      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // System Errors - Allow anyone to create, only admin to read
    match /system_errors/{errorId} {
      allow read: if isAdmin();
      allow create: if true; 
    }

    // System Test - Allow anyone to write for diagnostics
    match /system_test/{testId} {
      allow create: if true;
    }

    // System Config - Only admin can read/write
    match /system_config/{configId} {
      allow read, write: if isAdmin();
    }

    // Admins collection
    match /admins/{adminUid} {
      allow read: if isSignedIn();
      allow write: if false; // Only manageable via Firebase Console or special script
    }
  }
}
