{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with activity stats",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "isAdmin": { "type": "boolean" },
        "lastLogin": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "QuizResult": {
      "title": "Quiz Result",
      "description": "Historical quiz attempt record",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "subject": { "type": "string" },
        "score": { "type": "number" },
        "total": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "subject", "score", "total", "timestamp"]
    },
    "SystemError": {
      "title": "System Error",
      "description": "Logged system error for monitoring",
      "type": "object",
      "properties": {
        "message": { "type": "string" },
        "stack": { "type": "string" },
        "userEmail": { "type": "string" },
        "userId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile storage"
    },
    "/quizzes/{quizId}": {
      "schema": "QuizResult",
      "description": "Global quiz results"
    },
    "/system_errors/{errorId}": {
      "schema": "SystemError",
      "description": "System error logs"
    },
    "/admins/{adminUid}": {
      "schema": { "type": "object", "properties": { "email": { "type": "string" } } },
      "description": "Trusted admin UIDs"
    }
  }
}
