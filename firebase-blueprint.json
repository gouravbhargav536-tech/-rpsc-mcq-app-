{
  "entities": {
    "Subject": {
      "title": "Subject",
      "description": "An academic subject for RPSC exam preparation",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["name"]
    },
    "Question": {
      "title": "Question",
      "description": "A Multiple Choice Question",
      "type": "object",
      "properties": {
        "subject": { "type": "string" },
        "question": { "type": "string" },
        "options": {
          "type": "object",
          "properties": {
            "A": { "type": "string" },
            "B": { "type": "string" },
            "C": { "type": "string" },
            "D": { "type": "string" }
          }
        },
        "correctAnswer": { "type": "string" },
        "explanation": { "type": "string" },
        "language": { "type": "string" }
      },
      "required": ["subject", "question", "options", "correctAnswer", "language"]
    },
    "Attempt": {
      "title": "Attempt",
      "description": "A user's quiz attempt",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "subject": { "type": "string" },
        "score": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "subject", "score", "createdAt"]
    }
  },
  "firestore": {
    "/subjects/{subjectId}": {
      "schema": "Subject",
      "description": "Collection of all subjects"
    },
    "/questions/{questionId}": {
      "schema": "Question",
      "description": "Collection of all questions"
    },
    "/attempts/{attemptId}": {
      "schema": "Attempt",
      "description": "Collection of user quiz attempts"
    }
  }
}
